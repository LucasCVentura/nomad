# Copie este arquivo pra .env.local e preencha com os valores do seu projeto
# Supabase: Project Settings -> API (https://supabase.com/dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave secreta do Supabase (service role) — só no servidor, nunca no navegador.
# Usada pelo webhook de pagamento para liberar o acesso.
SUPABASE_SECRET_KEY=sua-service-role-key-aqui

# Asaas — https://sandbox.asaas.com (sandbox) ou https://www.asaas.com (produção).
# Cada ambiente tem conta e chave próprias: menu do usuário -> Integrações.
# Deixe ASAAS_ENV vazio ou "sandbox" enquanto testa; "production" só cobra de verdade.
# ATENÇÃO: a chave do Asaas começa com "$", e o Next expande variáveis nos
# arquivos .env — sem escapar, ela vira string vazia e o checkout falha com
# "ASAAS_API_KEY não configurada". Escape cada $ com barra invertida:
#   ASAAS_API_KEY=\$aact_hmlg_000...
# (No painel da Vercel isso não acontece: lá o valor vai literal, sem escapar.)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token que o Asaas envia no cabeçalho do webhook, definido por você ao
# cadastrar o webhook no painel deles. Serve para rejeitar chamadas forjadas.
ASAAS_WEBHOOK_TOKEN=
